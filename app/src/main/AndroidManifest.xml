<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      miuix-blur-android 在自己的清单里声明 minSdk 33（它整个库都依赖 RuntimeShader），
      而本工程 minSdk = 24，不禁用会让清单合并失败。
      官方文档给的正是这条路径：用 overrideLibrary 放开，然后在**代码里**用
      `isRuntimeShaderSupported()` 门控，保证低版本设备上完全不进入 blur 代码路径。
      见 ui/Glass.kt。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!--
      本应用实际需要的权限集：
      - INTERNET            模型 API / WebSearch / WebFetch
      - WAKE_LOCK           保活与 Agent 运行期唤醒锁
      - FOREGROUND_SERVICE  KeepAliveService / 内置 Termux 长任务
      - POST_NOTIFICATIONS  前台服务通知（Android 13+）
      - 存储三类           内置 Termux 的 ~/storage 映射与 /sdcard 访问
      - VIBRATE             交互反馈
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 保活引导
      - REQUEST_INSTALL_PACKAGES   APK 安装能力（AndroidIntent install_apk）

      刻意不带 SYSTEM_ALERT_WINDOW：它是悬浮窗专用权限，而唯一需要它的那个
      遗留 Service 已经删掉（它在代码里从来没有启动点），主界面与沙箱浮层都在
      自己的视图树里画，不需要在别人的应用上叠窗口。留着一个没有使用者的
      「可在其它应用上层显示」权限，对用户只是无谓的授权请求。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      targetSdk 28 时 Android 不做包可见性过滤，但 Android 11+ 的运行环境需要显式声明，
      否则 AndroidIntent 拿不到可处理的目标，浏览器 / 安装器都会失败。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".ZhiCodeApplication"
        android:allowBackup="false"
        android:label="ZhiCode"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!--
            largeHeap 是**止痛药，不是解药**。真机上这个应用原本的堆上限是 256MB
            （日志里的 growth limit 268435456），打开长会话时会被顶满并 FATAL。
            largeHeap 通常能把上限抬到约 512MB，让崩溃晚很多。

            真正的修复在别处：会话加载不再重复读整份数据、工具输出在列表里只留
            有界预览（展开时才取全文）、上下文用量估算不再每次重新序列化整份历史。
            如果哪台设备上发现 largeHeap 带来的常驻内存不可接受，删掉这一行即可 ——
            它不参与任何逻辑判断。
        -->

        <!--
          与上游实现对齐：把 AndroidX Startup 自动并进来的这两个组件摘掉。
          上游把它们列为**沙箱进程隔离的必要条件**（见 app/tests/SandboxProcessIsolationStructureTest）。

          InitializationProvider 是个 ContentProvider，而 ContentProvider 的创建时机在
          `Application.attachBaseContext` 之后、`Application.onCreate` **之前**。
          它会带起三个 initializer：
            - EmojiCompatInitializer        起后台线程加载 emoji 字体，走 IO
            - ProcessLifecycleInitializer   初始化 ProcessLifecycleOwner / LifecycleDispatcher
            - ProfileInstallerInitializer   调度 baseline profile 写入
          这些在沙箱宿主里既无必要，也会让启动期多出一条不受控的 IO/线程路径。

          安全性已核实：本工程源码、Miuix 全部 7 个 artifact 都不引用
          EmojiCompat / ProcessLifecycleOwner（Compose 的 EmojiCompat 用法有 isConfigured() 门控），
          摘掉后只是不再做 emoji span 处理，不影响功能。
        -->
        <provider android:name="androidx.startup.InitializationProvider" tools:node="remove" />
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          文本编辑器。**独立 Activity**（与 ZalithLauncher2 的 FileManagerActivity 同一形状）。

          为什么不做成主界面里的一个页面：那意味着返回键、返回手势与输入法可见性
          要在同一个窗口里和 NavDisplay、对话输入器分权 —— 反复出现的"编辑后返回不弹
          未保存确认""键盘时有时无"都出自这里。独立窗口之后，这一屏的返回只有一个入口
          （EditorActivity.onBackPressedDispatcher），输入法也只有一个主人。

          · windowSoftInputMode="adjustResize"：**不带** stateAlwaysHidden。
            主界面那份带它是为了让对话输入器不要一启动就弹键盘；编辑器正相反，
            用户点正文就该出键盘。这个标志正是"显示请求被系统回滚"的来源。
          · enableOnBackInvokedCallback="true"：让返回手势/预测性返回走
            OnBackPressedDispatcher（应用级已经开了，这里显式重复一次，
            因为这一屏的返回行为是关键路径，不该依赖继承）。
          · configChanges 覆盖 uiMode/locale/layoutDirection：应用内换主题、
            系统深浅变化时这一屏不重建，编辑中的正文与光标位置不会丢。
        -->
        <activity
            android:name=".editor.EditorActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|locale|layoutDirection"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:process=":editor"
            android:windowSoftInputMode="adjustResize" />

        <!--
          APK 分享用的只读 ContentProvider（AndroidIntent 工具 install_apk 依赖它）。

          没有这条声明，「用本地路径安装 APK」必然失败：AndroidIntentBridge.installApk
          会先调 ZhiFileProvider.uriForFile 把 /sdcard 或 $HOME 下的 APK 换成 content:// URI
          再交给系统安装器；provider 未注册时这一步直接抛异常，
          等于 AndroidIntent 的安装能力整个不可用。

          注意这是**自定义** ContentProvider（不是 androidx 的 FileProvider），
          它自己在 resolve() 里做根目录白名单与路径越界检查，
          所以不需要 file_paths 之类的 meta-data 资源。
        -->
        <provider
            android:name="com.zhizhu.zhicode.ZhiFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          Shizuku（https://github.com/RikkaApps/Shizuku）的授权通道。

          Shizuku 由用户通过 adb 或 Root 启动一个 shell 身份（uid 2000，Root 启动时是 0）
          的进程，再把它的 Binder 交给本应用 —— 于是「跑 pm/am/dumpsys/input 这类系统命令」
          不必让整台设备 root。这个 provider 就是管理端（含 Sui）投递 Binder 的入口，
          **不声明它，Shizuku.pingBinder() 永远是 false**。

          android:permission=INTERACT_ACROSS_USERS_FULL 是签名级权限：
          只有系统进程与 Shizuku 自身持有，第三方应用调不到，所以这里 exported 放为 true
          也不会把服务暴露出去（真正的访问控制由那一行权限完成）。
          android:multiprocess=false 让 provider 只活在主进程 —— 引擎与授权状态都在主进程，
          多一份副本意味着 pingBinder 的结论可能来自另一个进程。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          把 HOME 发布给系统文件管理器（DocumentsUI / 系统「文件」/「选择文件」）。

          为什么需要它：HOME 在应用私有目录里（0700 + SELinux），第三方文件管理器
          一个都进不去，不给 root 没有例外。而把 HOME 搬到共享存储的代价很大 ——
          那一片挂载是 noexec（/proc/mounts: /dev/fuse /storage/emulated fuse
          rw,nosuid,nodev,noexec），搬过去之后 ./gradlew 这类脚本就不能直跑了。
          本 provider 让文件管理器通过 SAF 读我们，HOME 一个字节都不用搬。

          android:permission="android.permission.MANAGE_DOCUMENTS" 是**必须的**，
          它既是功能要求也是安全边界：这一档是 signature|privileged 权限，
          只有系统进程持有 —— 于是只有 DocumentsUI 调得到，普通第三方应用调不到。
          exported="true" 是 SAF 的硬性要求（系统要能发现这个 provider），
          真正的访问控制由上面那一行权限完成。
        -->
        <provider
            android:name="com.zhizhu.zhicode.ZhiDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- 后台保活（用户显式开启） -->
        <service
            android:name="com.zhizhu.zhicode.background.KeepAliveService"
            android:exported="false"
            android:stopWithTask="false" />

        <!--
          ZhiCode 沙箱（BlackBox 虚拟 Android 运行时宿主）—— Phase 7。

          这三项是**宿主自己**的声明；Bcore 库自带的清单（DaemonService、
          SystemCallProvider、ProxyVpnService、LauncherActivity，以及 :p0..:p49 的
          四组 Proxy* 组件）会在依赖合并时自动并进来，不需要在这里重复写。

          SandboxRpcService 必须跑在 :zhisandbox 进程：
          它是主进程与沙箱引擎之间**同 UID 的私有 RPC** 通道，
          沙箱真正的高层控制面（安装/启动/停止 guest）全在这个进程里，
          不能放主进程，否则一个原生 hook 崩溃会把编辑器/Agent 一起带走。
        -->
        <provider
            android:name="com.zhizhu.zhicode.sandbox.SandboxRpcService"
            android:authorities="${applicationId}.sandbox.control"
            android:exported="false"
            android:process=":zhisandbox" />

        <!-- 沙箱管理界面。它本身留在主进程（不设 android:process），只通过上面的 provider 发指令 -->
        <activity
            android:name="com.zhizhu.zhicode.sandbox.SandboxBoard"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <!--
          调试 guest 期间的前台保活。guest Activity 会盖住主界面，
          没有它主进程会被系统回收，Agent/工具链会随之中断。
        -->
        <service
            android:name="com.zhizhu.zhicode.sandbox.SandboxKeeper"
            android:exported="false"
            android:stopWithTask="false" />

    </application>
</manifest>
